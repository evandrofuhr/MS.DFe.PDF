<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>netstandard2.0</TargetFramework>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageId>MS.DFe.PDF</PackageId>
	  <Version>1.1.3</Version>
	  <Authors>MicroSales</Authors>
	  <Company>MicroSales</Company>
	  <IsPackable>true</IsPackable>
	  <Description>Biblioteca de geração de PDF NF-e, NFC-e, CC-e, CT-e e MDF-e</Description>
	  <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Elementos\**" />
    <EmbeddedResource Remove="Elementos\**" />
    <None Remove="Elementos\**" />
  </ItemGroup>

  <!-- Liberation Serif (OFL) registrada como "Times New Roman" em Linux/Docker -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Fonts\LiberationSerif-Regular.ttf" />
    <EmbeddedResource Include="Resources\Fonts\LiberationSerif-Bold.ttf" />
    <EmbeddedResource Include="Resources\Fonts\LiberationSerif-Italic.ttf" />
    <EmbeddedResource Include="Resources\Fonts\LiberationSerif-BoldItalic.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hercules.NET.CTe" Version="2026.10.19.2059" />
    <PackageReference Include="Hercules.NET.MDFe" Version="2026.10.19.2059" />
    <PackageReference Include="Hercules.NET.NFe.NFCe" Version="2026.7.4.1436" />
    <PackageReference Include="QuestPDF" Version="2025.5.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.9" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.21" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\CCeResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CCeResource.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\CTeResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CTeResource.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\MDFeResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>MDFeResource.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\NFCeResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>NFCeResource.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\NFeResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>NFeResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\CCeResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CCeResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\CTeResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CTeResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\MDFeResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>MDFeResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NFCeResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>NFCeResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\NFeResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>NFeResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
